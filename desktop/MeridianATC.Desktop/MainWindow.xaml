<Window x:Class="MeridianATC.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:MeridianATC.Desktop.Pages"
        Title="MeridianATC" Width="1240" Height="800"
        Background="#FF0D1117" Foreground="#FFDDE5EE">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#FF11161D" BorderBrush="#FF2A3441"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16">
                    <TextBlock Text="MeridianATC" FontSize="20"
                               FontWeight="Bold" Foreground="#FFDDE5EE"/>
                    <TextBlock x:Name="ConnectionLine" Margin="0,4,0,0"
                               Foreground="#FF8A95A5" FontSize="12"
                               Text="connecting…"/>
                </StackPanel>
                <ScrollViewer>
                    <StackPanel x:Name="Nav" Margin="8"/>
                </ScrollViewer>
                <TextBlock DockPanel.Dock="Bottom" Margin="16,0,16,16"
                           Foreground="#FF55606F" FontSize="11"
                           Text="Entertainment use only. Not for real aviation."/>
            </DockPanel>
        </Border>
        <Frame x:Name="ScreenFrame" Grid.Column="1"
               NavigationUIVisibility="Hidden" Background="Transparent"/>
    </Grid>
</Window>
