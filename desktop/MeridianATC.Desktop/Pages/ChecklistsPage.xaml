<Page x:Class="MeridianATC.Desktop.Pages.ChecklistsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Checklists" Background="Transparent">
    <ScrollViewer>
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource Heading}" Text="Checklists"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}"
                               Margin="0,0,0,8"
                               Text="The first officer runs challenge-and-response checklists: they read the item, you answer, and where the simulator can tell, they check the answer against the aeroplane."/>
                    <ListBox x:Name="ChecklistList" Background="Transparent"
                             BorderThickness="0" Foreground="#FFB8C2CE"
                             MaxHeight="320"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource AccentButton}"
                                Content="Run selected"
                                Click="Run_Click"/>
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}"
                                Content="Refresh" Click="Refresh_Click"/>
                        <TextBlock x:Name="Status" VerticalAlignment="Center"
                                   Margin="12,0,0,0" Foreground="#FF8A95A5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
