<Page x:Class="MeridianATC.Desktop.Pages.FlightMonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Flight Monitor" Background="Transparent">
    <ScrollViewer>
        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Heading}" Text="Flight Monitor"
                           VerticalAlignment="Center"/>
                <Button Style="{StaticResource GhostButton}"
                        VerticalAlignment="Center" Margin="16,0,0,0"
                        Padding="10,4" Content="Refresh"
                        Click="Refresh_Click"/>
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="Left" Margin="0,0,8,0"/>
                    <StackPanel x:Name="Middle" Margin="0,0,8,0"
                                Grid.Column="1"/>
                    <StackPanel x:Name="Right" Grid.Column="2"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Foreground="#FF8A95A5" Margin="0,0,0,6"
                               Text="On the surface"/>
                    <WrapPanel x:Name="Surface" Orientation="Horizontal"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Foreground="#FF8A95A5" Margin="0,0,0,6"
                               Text="Traffic being worked"/>
                    <ListBox x:Name="Traffic" Background="Transparent"
                             BorderThickness="0" Foreground="#FFB8C2CE"
                             MaxHeight="260"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
