<Page x:Class="MeridianATC.Desktop.Pages.TranscriptPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Transcript" Background="Transparent">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Foreground="#FF8A95A5"
                           Margin="0,0,0,8" Text="Past flights"/>
                <Button DockPanel.Dock="Bottom" Margin="0,8,0,0"
                        Style="{StaticResource GhostButton}"
                        Content="Refresh" Click="Refresh_Click"/>
                <ListBox x:Name="Sessions" Background="Transparent"
                         BorderThickness="0" Foreground="#FFB8C2CE"
                         SelectionChanged="Sessions_Changed"/>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Margin="12,0,0,0"
                Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Foreground="#FF8A95A5"
                           Margin="0,0,0,8" Text="What was said"/>
                <ListBox x:Name="Lines" Background="Transparent"
                         BorderThickness="0" Foreground="#FFB8C2CE"
                         FontFamily="Consolas"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
