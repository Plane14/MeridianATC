<Page x:Class="MeridianATC.Desktop.Pages.FirstRunPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="First Run" Background="Transparent">
    <StackPanel Margin="40,24">
        <TextBlock Style="{StaticResource Heading}" Text="Welcome to MeridianATC"/>
        <Border Style="{StaticResource Card}" MaxWidth="640">
            <StackPanel>
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12">
                    A voice-driven ATC companion for Microsoft Flight
                    Simulator 2024 — for entertainment and training, never
                    for real aviation. The deterministic engine is
                    authoritative for everything: cloud services, when you
                    enable them, can only listen and rephrase, never decide.
                </TextBlock>
                <CheckBox x:Name="Consent" Foreground="#FFB8C2CE"
                          Margin="0,0,0,6"
                          Content="I consent to optional cloud services (speech recognition, language models, SimBrief) sending my voice text and flight details to their endpoints. The program works fully offline without this."/>
                <Button Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0"
                        Content="Continue" Click="Continue_Click"/>
                <TextBlock x:Name="Result" Margin="0,10,0,0"
                           Foreground="#FF8A95A5"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
