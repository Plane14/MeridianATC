<Page x:Class="MeridianATC.Desktop.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Diagnostics" Background="Transparent">
    <ScrollViewer>
        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Heading}"
                           VerticalAlignment="Center" Text="Diagnostics"/>
                <Button Style="{StaticResource GhostButton}"
                        VerticalAlignment="Center" Margin="16,0,0,0"
                        Padding="10,4" Content="Run doctor"
                        Click="Doctor_Click"/>
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <ListBox x:Name="DoctorList" Background="Transparent"
                         BorderThickness="0" Foreground="#FFB8C2CE"
                         MaxHeight="380" FontFamily="Consolas"/>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Foreground="#FF8A95A5" Margin="0,0,0,6"
                               Text="Voice trainer — keyterms and corrections"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="KeytermBox" Padding="8"
                                 Background="#FF1B222D" Foreground="#FFDDE5EE"
                                 BorderBrush="#FF2A3441" BorderThickness="1"
                                 ToolTip="A word the recogniser should hear better"/>
                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}"
                                Content="Add keyterm" Click="AddKeyterm_Click"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HeardBox" Padding="8" Margin="0,0,6,0"
                                 Background="#FF1B222D" Foreground="#FFDDE5EE"
                                 BorderBrush="#FF2A3441" BorderThickness="1"
                                 ToolTip="What it heard"/>
                        <TextBox Grid.Column="1" x:Name="MeantBox" Padding="8"
                                 Margin="0,0,6,0" Background="#FF1B222D"
                                 Foreground="#FFDDE5EE"
                                 BorderBrush="#FF2A3441" BorderThickness="1"
                                 ToolTip="What you meant"/>
                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButton}"
                                Content="Add correction"
                                Click="AddCorrection_Click"/>
                    </Grid>
                    <ListBox x:Name="TrainerList" Background="Transparent"
                             BorderThickness="0" Foreground="#FFB8C2CE"
                             MaxHeight="160" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
