          "response": "low idle",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "condition_pct",
            "op": "min",
            "value": 40
          }
        },
        {
          "challenge": "Engine start",
          "response": "release when engine is running",
          "accept": [
            "check",
            "set"
          ]
        },
        {
          "challenge": "Ignition",
          "response": "off",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "ignition_on",
            "op": "eq",
            "value": false
