        },
        {
          "challenge": "Condition lever",
          "response": "cutoff",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "condition_pct",
            "op": "max",
            "value": 10
          }
        },
        {
          "challenge": "Propeller lever",
          "response": "feather",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "prop_pct",
            "op": "max",
            "value": 10
          }
