          "accept": [
            "set",
            "check"
          ]
        },
        {
          "challenge": "Engine instruments",
          "response": "checked",
          "accept": [
            "check"
          ]
        },
        {
          "challenge": "Fuel system",
          "response": "checked",
          "accept": [
            "check"
          ]
