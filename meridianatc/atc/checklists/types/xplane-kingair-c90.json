{
  "_comment": "X-Plane 12 Beechcraft King Air C90B manual checklists (x-plane.com/support/manuals/), mapped onto the standard names.",
  "source": "X-Plane 12 Beechcraft King Air C90B manual, checklists section",
  "match": [
    "king air c90",
    "c90b"
  ],
  "checklists": {
    "before_start": {
      "title": "before starting engines",
      "items": [
        {
          "challenge": "Exterior inspection",
          "response": "completed",
          "accept": [
            "complete",
            "check"
          ],
          "note": "Passenger door closed; control surfaces, flaps and all exterior lights checked."
        },
        {
          "challenge": "Power levers",
          "response": "idle",
          "accept": [
            "set",
            "check"
          ]
        },
        {
          "challenge": "Propeller levers",
          "response": "full forward",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "prop_pct",
            "op": "min",
            "value": 90
          }
        },
        {
          "challenge": "Condition levers",
          "response": "cut off",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "condition_pct",
            "op": "max",
            "value": 10
          }
        },
        {
          "challenge": "All switches",
          "response": "off",
          "accept": [
            "off",
            "check"
          ]
        },
        {
          "challenge": "Battery switch",
          "response": "on",
          "accept": [
            "on"
          ],
          "check": {
            "var": "battery_master",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Fuel quantity",
          "response": "check",
          "accept": [
            "check"
          ]
        }
      ]
    },
    "after_start": {
      "title": "engine start",
      "items": [
        {
          "challenge": "Inverter one or two",
          "response": "on",
          "accept": [
            "on",
            "set"
          ]
        },
        {
          "challenge": "Right engine auto ignition arm",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "eng2_ignition_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Right ignition and engine start switch",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "eng2_ignition_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "At twelve percent turbine RPM, right condition lever",
          "response": "low idle",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "condition_pct",
            "op": "near",
            "value": 50,
            "tolerance": 15
          }
        },
        {
          "challenge": "Right engine oil pressure and turbine RPM",
          "response": "check",
          "accept": [
            "check",
            "green"
          ],
          "check": {
            "var": "eng2_oil_pressure_psi",
            "op": "min",
            "value": 10
          }
        },
        {
          "challenge": "Right generator",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "eng2_generator_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Left engine auto ignition arm",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "ignition_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Left ignition and engine start switch",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "ignition_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "At twelve percent turbine RPM, left condition lever",
          "response": "low idle",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "condition_pct",
            "op": "near",
            "value": 50,
            "tolerance": 15
          }
        },
        {
          "challenge": "Left engine oil pressure and turbine RPM",
          "response": "check",
          "accept": [
            "check",
            "green"
          ],
          "check": {
            "var": "oil_pressure_psi",
            "op": "min",
            "value": 10
          }
        },
        {
          "challenge": "Left generator",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "generator_on",
            "op": "eq",
            "value": true
          }
        }
      ]
