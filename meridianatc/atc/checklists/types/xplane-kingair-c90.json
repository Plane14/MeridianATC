            "up",
            "check"
          ],
          "check": {
            "var": "flaps_index",
            "op": "eq",
            "value": 0
          }
        },
        {
          "challenge": "Climb power",
          "response": "set",
          "accept": [
            "set",
            "check"
          ]
        },
        {
          "challenge": "Propeller RPM",
          "response": "two thousand",
          "accept": [
            "set",
            "check"
          ]
        },
        {
          "challenge": "Auto feather",
          "response": "off",
          "accept": [
            "off",
            "set"
          ]
        },
        {
          "challenge": "Engine instruments",
          "response": "monitor",
          "accept": [
