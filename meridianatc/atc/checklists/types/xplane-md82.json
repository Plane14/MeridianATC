{
  "_comment": "X-Plane 12 McDonnell Douglas MD-82 manual checklists (x-plane.com/support/manuals/), mapped onto the standard names.",
  "source": "X-Plane 12 McDonnell Douglas MD-82 manual, checklists section",
  "match": [
    "mcdonnell douglas md-82",
    "md-82"
  ],
  "checklists": {
    "after_start": {
      "title": "cold and dark to engine start",
      "items": [
        {
          "challenge": "Parking brake",
          "response": "check on, lever up",
          "accept": [
            "on",
            "check"
          ],
          "check": {
            "var": "parking_brake",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Battery master",
          "response": "on",
          "accept": [
            "on"
          ],
          "check": {
            "var": "battery_master",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Engine start pump",
          "response": "on",
          "accept": [
            "on",
            "set"
          ]
        },
        {
          "challenge": "APU master",
          "response": "start then run",
          "accept": [
            "set",
            "on"
          ],
          "note": "Wait for the APU power available light.",
          "check": {
            "var": "apu_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "APU left and right bus",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "apu_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Left and right generators",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "eng2_generator_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "APU air",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "apu_bleed_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Pneumatic cross valves",
          "response": "open, up",
          "accept": [
            "set",
            "check"
          ]
        },
        {
          "challenge": "Aux transfer pump",
          "response": "on",
          "accept": [
            "on",
            "set"
          ]
        },
        {
          "challenge": "Left, center and right fuel pumps",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "eng2_fuel_pump_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Engine start system",
          "response": "select A or B",
          "accept": [
            "set",
            "check"
          ]
        },
        {
          "challenge": "Right engine",
          "response": "start, hold for twenty percent N-two; fuel control lever up",
          "accept": [
            "set",
            "on"
          ]
        },
        {
          "challenge": "Left engine",
          "response": "start, hold for twenty percent N-two; fuel control lever up",
          "accept": [
            "set",
            "on"
          ]
        },
        {
          "challenge": "Engine start pump",
          "response": "off",
          "accept": [
            "off",
            "set"
          ]
        },
        {
          "challenge": "AC bus cross-tie",
          "response": "auto",
          "accept": [
            "set",
            "check"
          ]
        },
        {
          "challenge": "APU bus left and right",
          "response": "off",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "apu_pct",
            "op": "max",
            "value": 5
          }
        },
        {
          "challenge": "APU air",
          "response": "off",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "apu_bleed_on",
            "op": "eq",
            "value": false
          }
        },
        {
          "challenge": "APU master",
          "response": "off",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "apu_pct",
            "op": "max",
            "value": 5
          }
        }
      ]
