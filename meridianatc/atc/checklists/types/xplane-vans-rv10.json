{
  "_comment": "X-Plane 12 Van's RV-10 manual checklists (x-plane.com/support/manuals/), mapped onto the standard names.",
  "source": "X-Plane 12 Van's RV-10 manual, checklists section",
  "match": [
    "rv-10",
    "rv10",
    "van's rv"
  ],
  "checklists": {
    "after_start": {
      "title": "cold and dark to engine start",
      "items": [
        {
          "challenge": "Cabin door",
          "response": "closed",
          "accept": [
            "check",
            "set"
          ],
          "check": {
            "var": "exits_open_pct",
            "op": "max",
            "value": 5
          }
        },
        {
          "challenge": "Parking brake",
          "response": "check on",
          "accept": [
            "on",
            "check"
          ],
          "check": {
            "var": "parking_brake",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Fuel selector",
          "response": "as required, left or right tank",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "fuel_selector",
            "op": "in",
            "value": [
              2,
              18
            ]
          }
        },
        {
          "challenge": "Battery master",
          "response": "on",
          "accept": [
            "on"
          ],
          "check": {
            "var": "battery_master",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Fuel quantity",
          "response": "check",
          "accept": [
            "check"
          ]
        },
        {
          "challenge": "Mixture",
          "response": "full rich",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "mixture_pct",
            "op": "min",
            "value": 95
          }
        },
        {
          "challenge": "Fuel pump",
          "response": "on for two seconds, then off",
          "accept": [
            "set",
            "check"
          ]
        },
        {
          "challenge": "Throttle",
          "response": "idle",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "throttle_pct",
            "op": "max",
            "value": 10
          }
        },
        {
          "challenge": "Strobes",
          "response": "on",
          "accept": [
            "on"
          ],
          "check": {
            "var": "strobe_light",
            "op": "eq",
            "value": true
          },
          "note": "The manual: no beacon on this aircraft; strobes warn of engine start."
        },
        {
          "challenge": "Engine",
          "response": "start, press and hold briefly",
          "accept": [
            "set",
            "on"
          ]
        },
        {
          "challenge": "Alternator",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "alternator_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Avionics master",
          "response": "on",
          "accept": [
            "on"
          ],
          "check": {
            "var": "avionics_master",
            "op": "eq",
            "value": true
          }
        }
      ]
    },
    "taxi": {
      "title": "before taxi",
      "items": [
        {
          "challenge": "Elevator trim",
          "response": "takeoff",
          "accept": [
            "set",
            "check"
          ]
        },
        {
          "challenge": "Flight controls",
          "response": "checked, pitch roll yaw",
          "accept": [
            "check"
          ]
        },
        {
          "challenge": "Strobes",
          "response": "as required",
          "accept": [
            "set",
            "check"
          ]
        },
        {
          "challenge": "Nav lights",
          "response": "on",
          "accept": [
            "on"
          ],
          "check": {
            "var": "nav_light",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Taxi lights",
          "response": "on",
          "accept": [
            "on"
          ],
          "check": {
            "var": "taxi_light",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Transponder",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "transponder_state",
            "op": "in",
            "value": [
              3,
              4,
              5
            ]
          }
        },
        {
          "challenge": "Parking brake",
          "response": "off",
          "accept": [
            "off"
          ],
          "check": {
            "var": "parking_brake",
            "op": "eq",
            "value": false
          }
        }
      ]
    },
    "before_takeoff": {
      "title": "before takeoff",
      "items": [
        {
          "challenge": "Flaps",
          "response": "set, fifty percent",
          "accept": [
            "set",
            "check"
          ],
          "note": "Takeoff flap per the manual: 50%."
        },
        {
          "challenge": "Altimeter",
          "response": "set",
          "accept": [
            "set",
            "value"
          ],
          "check": {
            "var": "kohlsman_hpa",
            "op": "near",
            "value": "$qnh",
            "tolerance": 1.0
          }
        },
        {
          "challenge": "Landing lights",
          "response": "on",
          "accept": [
            "on"
          ],
          "check": {
            "var": "landing_light",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Taxi lights",
          "response": "off",
          "accept": [
            "off"
          ],
          "check": {
            "var": "taxi_light",
            "op": "eq",
            "value": false
          }
        },
        {
          "challenge": "Transponder",
          "response": "alt",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "transponder_state",
            "op": "in",
            "value": [
              3,
              4
            ]
          },
          "note": "UNVERIFIED: TRANSPONDER STATE values are program-defined and unmeasured on a live sim."
        }
      ]
    },
    "after_takeoff": {
      "title": "after takeoff",
      "items": [
        {
          "challenge": "Flaps",
          "response": "retracted",
          "accept": [
            "up"
          ],
          "check": {
            "var": "flaps_index",
            "op": "eq",
            "value": 0
          }
        },
        {
          "challenge": "Throttle",
          "response": "set as required",
          "accept": [
            "set",
            "check"
          ]
        }
      ]
    },
    "cruise": {
      "title": "cruise",
      "items": [
        {
          "challenge": "Landing lights",
          "response": "off",
          "accept": [
            "off"
          ],
          "check": {
            "var": "landing_light",
            "op": "eq",
            "value": false
          }
        },
        {
          "challenge": "Mixture",
          "response": "lean as required",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "mixture_pct",
            "op": "max",
            "value": 95
          }
        },
        {
          "challenge": "Altimeter",
          "response": "set",
          "accept": [
            "set",
            "value"
          ],
          "check": {
            "var": "kohlsman_hpa",
            "op": "near",
            "value": "$qnh",
            "tolerance": 1.0
          }
        }
      ]
    },
    "before_landing": {
      "title": "before landing",
      "items": [
        {
          "challenge": "Altimeter",
          "response": "set",
          "accept": [
            "set",
            "value"
          ],
          "check": {
            "var": "kohlsman_hpa",
            "op": "near",
            "value": "$qnh",
            "tolerance": 1.0
          }
        },
        {
          "challenge": "Landing lights",
          "response": "on",
          "accept": [
            "on"
          ],
          "check": {
            "var": "landing_light",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Mixture",
          "response": "full rich",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "mixture_pct",
            "op": "min",
            "value": 95
          }
        },
        {
          "challenge": "Flaps",
          "response": "as required, one hundred percent for landing",
          "accept": [
            "set",
            "down"
          ]
        }
      ]
    },
    "after_landing": {
      "title": "after landing",
      "items": [
        {
          "challenge": "Flaps",
          "response": "retracted",
          "accept": [
            "up"
          ],
          "check": {
            "var": "flaps_index",
            "op": "eq",
            "value": 0
          }
        },
        {
          "challenge": "Transponder",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "transponder_state",
            "op": "in",
            "value": [
              3,
              4,
              5
            ]
          }
        }
      ]
    },
    "shutdown": {
      "title": "parking",
      "items": [
        {
          "challenge": "Throttle",
          "response": "idle",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "throttle_pct",
            "op": "max",
            "value": 10
          }
        },
        {
          "challenge": "Parking brake",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "parking_brake",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Mixture",
          "response": "cut off",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "mixture_pct",
            "op": "max",
            "value": 5
          }
        },
        {
          "challenge": "Fuel selector",
          "response": "off",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "fuel_selector",
            "op": "eq",
            "value": 0
          }
        },
        {
          "challenge": "Transponder",
          "response": "standby",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "transponder_state",
            "op": "eq",
            "value": 1
          }
        },
        {
          "challenge": "Avionics master",
          "response": "off",
          "accept": [
            "off"
          ],
          "check": {
            "var": "avionics_master",
            "op": "eq",
            "value": false
          }
        },
        {
          "challenge": "Alternator",
          "response": "off",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "alternator_on",
            "op": "eq",
            "value": false
          }
        },
        {
          "challenge": "Battery master",
          "response": "off",
          "accept": [
            "off"
          ],
          "check": {
            "var": "battery_master",
            "op": "eq",
            "value": false
          }
        }
      ]
    }
  }
}
