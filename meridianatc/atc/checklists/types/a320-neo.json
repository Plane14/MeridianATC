          "challenge": "Weather Briefing (METAR / TAF / Sigmet)",
          "response": "weather.",
          "accept": [
            "check"
          ],
          "note": "Check departure, enroute, destination, and alternate weather."
        },
        {
          "challenge": "NOTAMs",
