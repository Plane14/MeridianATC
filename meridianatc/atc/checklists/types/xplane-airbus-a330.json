{
  "_comment": "X-Plane 12 Airbus A330-300 manual checklists (x-plane.com/support/manuals/), mapped onto the standard names. The manual's cold-and-dark is a subset of the real procedure for the X-Plane model.",
  "source": "X-Plane 12 Airbus A330-300 manual, checklists section",
  "match": [
    "a330-300",
    "airbus a330",
    "a330-343"
  ],
  "checklists": {
    "after_start": {
      "title": "cold and dark to engine start",
      "items": [
        {
          "challenge": "Parking brake",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "parking_brake",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Transponder",
          "response": "standby",
          "accept": [
            "set",
            "off"
          ],
          "check": {
            "var": "transponder_state",
            "op": "eq",
            "value": 1
          }
        },
        {
          "challenge": "Batteries one and two",
          "response": "on",
          "accept": [
            "on"
          ],
          "check": {
            "var": "battery_master",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "External power",
          "response": "on",
          "accept": [
            "on",
            "set"
          ]
        },
        {
          "challenge": "Beacon",
          "response": "on",
          "accept": [
            "on"
          ],
          "check": {
            "var": "beacon_light",
            "op": "eq",
            "value": true
