        {
          "challenge": "PAX system",
          "response": "on",
          "accept": [
            "on",
            "set"
          ]
        },
        {
          "challenge": "APU bleed",
          "response": "on",
          "accept": [
            "on",
            "set"
          ]
        },
        {
          "challenge": "MCDU",
          "response": "flight plan, cruise flight level and V-speeds entered",
          "accept": [
            "set",
            "check"
          ],
          "note": "The manual: without calculated V-speeds use the flap-retraction speed for V2, VR as V2 minus 5, V1 as V2 minus 10; takeoff flap 1 or 2."
        },
        {
          "challenge": "Flight control systems",
          "response": "all on",
          "accept": [
            "on",
            "set"
          ]
        },
        {
          "challenge": "GPWS aural alerts",
          "response": "all on",
          "accept": [
            "on",
            "set"
          ]
        },
        {
          "challenge": "Hydraulic and fuel pumps",
          "response": "all on",
          "accept": [
            "on",
            "set"
          ]
        },
        {
