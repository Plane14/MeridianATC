          "response": "on",
          "accept": [
            "on",
            "set"
          ]
        },
        {
          "challenge": "Engine two",
          "response": "start rotary to IGN start; engine start switch on; monitor until stabilized",
          "accept": [
            "set",
            "on"
          ]
        },
        {
          "challenge": "Engine one",
          "response": "start switch on; monitor until stabilized",
          "accept": [
            "set",
            "on"
          ]
        },
        {
          "challenge": "Engine start rotary",
          "response": "normal",
          "accept": [
            "set",
            "check"
          ]
