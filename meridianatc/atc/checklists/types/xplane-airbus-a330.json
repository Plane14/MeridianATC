            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "APU",
          "response": "start; wait for APU avail",
          "accept": [
            "set",
            "on"
          ],
          "check": {
            "var": "apu_pct",
            "op": "min",
            "value": 80
          }
        },
        {
          "challenge": "APU generator",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
