        {
          "challenge": "Transponder",
          "response": "alt off",
          "accept": [
            "set",
            "off"
          ],
          "check": {
            "var": "transponder_state",
            "op": "in",
            "value": [
              3,
              4,
              5
            ]
          }
        }
      ]
    },
    "shutdown": {
      "title": "parking",
      "items": [
        {
          "challenge": "Parking brake",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "parking_brake",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Seatbelt sign",
          "response": "off",
          "accept": [
            "off"
          ],
          "check": {
            "var": "seatbelt_sign",
            "op": "eq",
            "value": false
          }
        },
        {
          "challenge": "Transponder",
          "response": "standby",
          "accept": [
            "set",
            "off"
          ],
          "check": {
            "var": "transponder_state",
            "op": "eq",
            "value": 1
          }
        },
        {
          "challenge": "Engine generators one and two",
          "response": "off",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "eng2_generator_on",
            "op": "eq",
            "value": false
          }
        },
        {
          "challenge": "Fuel control levers",
          "response": "down, off",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "engines_running",
            "op": "eq",
            "value": false
          }
        },
        {
          "challenge": "Hydraulic pumps A and B",
          "response": "off",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "hydraulic_pump_on",
            "op": "eq",
