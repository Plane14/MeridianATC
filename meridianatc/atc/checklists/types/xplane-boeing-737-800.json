        {
          "challenge": "Standby power",
          "response": "off",
          "accept": [
            "off",
            "set"
          ]
        },
        {
          "challenge": "Battery master",
          "response": "off",
          "accept": [
            "off"
          ],
          "check": {
            "var": "battery_master",
