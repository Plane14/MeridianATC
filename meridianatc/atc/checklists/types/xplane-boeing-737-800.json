    "after_landing": {
      "title": "after landing",
      "items": [
        {
          "challenge": "Flaps",
          "response": "retracted",
          "accept": [
            "up"
          ],
          "check": {
            "var": "flaps_index",
            "op": "eq",
            "value": 0
          }
        },
        {
          "challenge": "Speed brakes",
          "response": "retracted",
          "accept": [
            "set",
            "check"
          ],
          "check": {
            "var": "spoilers_armed",
            "op": "eq",
            "value": false
