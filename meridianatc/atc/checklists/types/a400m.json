{
  "_comment": "Converted from StormATC data/flightchecklists/a400m.json (Airbus A400M Atlas). Verification steps keep their challenge and note rather than a guessed simvar check. The source flattened every flight phase into one list; items from engine start onward are deliberately not kept in preflight, so the correct class phase cards own them.",
  "source": "StormATC Airbus A400M Atlas checklist set",
  "match": [
    "a400m",
    "airbus",
    "atlas"
  ],
  "checklists": {
    "preflight": {
      "title": {
        "en": "preflight"
      },
      "items": [
        {
          "challenge": "Weather Briefing",
          "response": "weather.",
          "accept": [
            "check"
          ],
          "note": "Check departure, enroute, destination weather."
        },
        {
          "challenge": "NOTAMs",
          "response": "closures.",
          "accept": [
            "check"
          ],
          "note": "Check for runway closures."
        },
        {
          "challenge": "Flight Plan",
          "response": "verify.",
          "accept": [
            "check"
          ],
          "note": "LOAD and verify."
        },
        {
          "challenge": "Fuel Planning",
          "response": "reserves.",
          "accept": [
            "check"
          ],
          "note": "Calculate block fuel plus reserves."
        },
        {
          "challenge": "Weight & Balance / Loadsheet",
          "response": "limits.",
          "accept": [
            "check"
          ],
          "note": "Verify within limits."
        },
        {
          "challenge": "Performance - Takeoff Speeds",
          "response": "calculated.",
          "accept": [
            "value",
            "check"
          ],
          "note": "V1, VR, V2 calculated."
        },
        {
          "challenge": "Battery",
          "response": "on.",
          "check": {
            "var": "battery_master",
            "op": "eq",
            "value": true
          },
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ]
        },
        {
          "challenge": "External Power",
          "response": "available.",
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ],
          "note": "ON if available."
        },
        {
          "challenge": "APU",
          "response": "start.",
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ],
          "check": {
            "var": "apu_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "APU Bleed",
          "response": "on.",
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ],
          "check": {
            "var": "apu_bleed_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Navigation Lights",
          "response": "on.",
          "check": {
            "var": "nav_light",
            "op": "eq",
            "value": true
          },
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ]
        },
        {
          "challenge": "Seat Belts Sign",
          "response": "on.",
          "check": {
            "var": "seatbelt_sign",
            "op": "eq",
            "value": true
          },
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ]
        },
        {
          "challenge": "Fuel Pumps",
          "response": "on.",
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ],
          "check": {
            "var": "fuel_pump_on",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "FMC - Route",
          "response": "verify.",
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ],
          "note": "ENTER and verify."
        },
        {
          "challenge": "FMC - Performance",
          "response": "speeds.",
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ],
          "note": "ENTER fuel, weights, speeds."
        },
        {
          "challenge": "FCU Altitude",
          "response": "altitude.",
          "check": {
            "var": "ap_altitude_ft",
            "op": "near",
            "value": "$altitude",
            "tolerance": 100
          },
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ],
          "note": "SET initial climb altitude."
        },
        {
          "challenge": "Transponder",
          "response": "stby.",
          "check": {
            "var": "transponder_state",
            "op": "eq",
            "value": 1
          },
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ],
          "note": "SET - STBY."
        },
        {
          "challenge": "Parking Brake",
          "response": "set.",
          "check": {
            "var": "parking_brake",
            "op": "eq",
            "value": true
          },
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ]
        },
        {
          "challenge": "Doors",
          "response": "closed.",
          "accept": [
            "check"
          ],
          "check": {
            "var": "exits_open_pct",
            "op": "max",
            "value": 5
          }
        },
        {
          "challenge": "Thrust Levers",
          "response": "idle.",
          "check": {
            "var": "throttle_pct",
            "op": "max",
            "value": 5
          },
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ]
        },
        {
          "challenge": "Packs",
          "response": "off.",
          "accept": [
            "set",
            "on",
            "off",
            "check"
          ],
          "check": {
            "var": "pack_left_on",
            "op": "eq",
            "value": false
          }
        }
      ]
    }
  }
}
