          "challenge": "Taxi lights",
          "response": "on",
          "accept": [
            "on"
          ],
          "check": {
            "var": "taxi_light",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Landing lights",
          "response": "off",
          "accept": [
            "off"
          ],
          "check": {
            "var": "landing_light",
            "op": "eq",
            "value": false
          }
        },
        {
          "challenge": "Transponder",
          "response": "standby",
          "accept": [
            "set",
            "off"
          ],
          "check": {
            "var": "transponder_state",
            "op": "eq",
            "value": 1
          }
        }
      ]
    },
    "shutdown": {
      "title": "parking",
      "items": [
        {
          "challenge": "Parking brake",
          "response": "on",
          "accept": [
            "on",
            "set"
          ],
          "check": {
            "var": "parking_brake",
            "op": "eq",
            "value": true
          }
        },
        {
          "challenge": "Throttles",
          "response": "cut off",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "throttle_pct",
            "op": "max",
            "value": 5
          }
        },
        {
          "challenge": "Seatbelt sign",
          "response": "off",
          "accept": [
            "off"
          ],
          "check": {
            "var": "seatbelt_sign",
            "op": "eq",
            "value": false
          }
        },
        {
          "challenge": "Left and right center wing transfer",
          "response": "off",
          "accept": [
            "off",
            "set"
          ]
        },
        {
          "challenge": "Left and right generators",
          "response": "off",
          "accept": [
            "off",
            "set"
          ],
          "check": {
            "var": "eng2_generator_on",
            "op": "eq",
