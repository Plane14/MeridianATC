            "value": false
          }
        },
        {
          "challenge": "EICAS",
          "response": "off",
          "accept": [
            "off",
            "set"
          ]
        },
        {
          "challenge": "Battery one and two",
          "response": "off",
          "accept": [
            "off"
          ],
          "check": {
            "var": "battery_master",
            "op": "eq",
            "value": false
